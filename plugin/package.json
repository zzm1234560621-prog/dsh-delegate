{
  "name": "dsh-delegate",
  "version": "1.1.0",
  "description": "Delegate mechanical tasks from a strong model to a local DeepSeek Harness subagent: parallel fan-out, write scopes, long-job polling, plus a local dashboard.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "mcp",
    "subagent",
    "delegation"
  ],
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./server/*": "./server/*"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "server",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
