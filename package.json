{
  "name": "dsh-delegate",
  "version": "1.0.0",
  "description": "Let Claude Desktop, Claude Code and Codex delegate self-contained tasks to a local DeepSeek Harness (DSH) subagent over MCP: parallel fan-out with per-task write scopes, async jobs that outlive host timeouts, token stats and a local dashboard. Zero dependencies.",
  "license": "MIT",
  "author": "zzm1234560621-prog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzm1234560621-prog/dsh-delegate.git"
  },
  "homepage": "https://github.com/zzm1234560621-prog/dsh-delegate#readme",
  "bugs": {
    "url": "https://github.com/zzm1234560621-prog/dsh-delegate/issues"
  },
  "bin": {
    "dsh-delegate": "bin/dsh-delegate.js"
  },
  "main": "lib/mcp.js",
  "type": "commonjs",
  "files": [
    "bin",
    "lib",
    "assets",
    "install.cmd",
    "install.ps1",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install:local": "node bin/dsh-delegate.js install",
    "daemon": "node bin/dsh-delegate.js daemon",
    "daemon:api": "node bin/dsh-delegate.js daemon --no-ui",
    "status": "node bin/dsh-delegate.js status",
    "doctor": "node bin/dsh-delegate.js doctor",
    "test": "node test/smoke.js",
    "test:edge": "node test/edge.js",
    "test:regress": "node test/regress.js",
    "test:live": "node test/live.js",
    "test:all": "node test/smoke.js && node test/edge.js && node test/regress.js",
    "sync:plugin": "node -e \"const fs=require('fs');for(const f of fs.readdirSync('lib'))fs.copyFileSync('lib/'+f,'plugin/server/lib/'+f)\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-desktop",
    "codex",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "subagent",
    "delegation"
  ]
}
